# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env.development

# Server-side local cab development data (contains customer details)
/.cab-data/
/.cab-test-data/
/artifacts/cab-live/chrome-profile/
/artifacts/cab-system/chrome-profile/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local browser verification profiles
.chrome*/
.edge*/


# Admin browser validation profile
/artifacts/admin-browser-profile/

# Sanitized deployment source archives
/artifacts/production-deployment/
